!/checkpoints/**/
!/checkpoints/**/args.json
!/checkpoints/.gitkeep

# Generated runtime output; retain lightweight historical summary tables/figures.
/result/
/outputs/
/logs/
/results/raw/
/results/stats/*
!/results/stats/*summary.tex
/results/profiling/raw/
*.pid
*.logpath

# Manuscript source and private execution/review notes are outside the code release.
/main.tex
/responseletter.tex
/docs/experiment_status.md
/docs/*audit*.md
